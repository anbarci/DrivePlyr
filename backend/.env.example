# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/driveplyr
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/driveplyr

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Google Drive API
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# Player Base URL (used by config.js on the frontend)
PLAYER_BASE_URL=https://sh20raj.github.io/DrivePlyr/

# CORS
CORS_ORIGIN=http://localhost:3000,https://anbarci.github.io

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin Credentials (First Time Setup)
ADMIN_EMAIL=admin@driveplyr.com
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin

# Hotlink Protection
ALLOWED_DOMAINS=anbarci.github.io,localhost

# Analytics
ENABLE_ANALYTICS=true